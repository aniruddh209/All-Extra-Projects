@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Access Denied";
}

<div class="d-flex flex-column align-items-center justify-content-center py-5">
  <div style="width:90px;height:90px;background:linear-gradient(135deg,#dc2626,#f87171);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:1.5rem;box-shadow:0 8px 24px rgba(220,38,38,.3);">
    <i class="bi bi-shield-x" style="font-size:2.5rem;color:#fff;"></i>
  </div>
  <h2 class="fw-bold mb-2" style="color:#dc2626;">Access Denied</h2>
  <p class="text-muted text-center" style="max-width:400px;">
    You do not have administrator privileges to view this page.
    Please log in with an Admin account.
  </p>
  <div class="d-flex gap-3 mt-3">
    <a asp-action="AdminLogin" class="btn fw-bold px-4" style="background:linear-gradient(135deg,var(--adm-primary),var(--adm-accent));color:#fff;border:none;border-radius:8px;">
      <i class="bi bi-shield-lock me-2"></i>Admin Login
    </a>
    <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary" style="border-radius:8px;">
      <i class="bi bi-arrow-left me-1"></i>Member Login
    </a>
  </div>
</div>
