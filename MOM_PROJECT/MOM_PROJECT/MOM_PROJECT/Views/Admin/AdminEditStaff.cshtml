@model MOM_PROJECT.Models.AdminEditStaffModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Edit Staff";
    int? returnUserId = ViewBag.ReturnUserID as int?;
}
<div class="pagetitle mb-3">
  <h1><i class="bi bi-person-gear me-2" style="color:var(--adm-primary);"></i>Edit Staff</h1>
  <nav><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li>
    @if (returnUserId.HasValue)
    {
      <li class="breadcrumb-item"><a asp-action="UserDetail" asp-route-id="@returnUserId.Value">User</a></li>
    }
    <li class="breadcrumb-item"><a asp-action="AllStaff">Staff</a></li>
    <li class="breadcrumb-item active">Edit</li>
  </ol></nav>
</div>
<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm" style="border-radius:16px;">
      <div class="card-header border-0" style="background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px 16px 0 0;padding:1rem 1.4rem;">
        <h6 class="mb-0 text-white fw-bold"><i class="bi bi-person-badge me-2"></i>Staff Details</h6>
      </div>
      <div class="card-body p-4">
        <form asp-action="AdminEditStaff" method="post">
          @Html.AntiForgeryToken()
          <input asp-for="StaffID" type="hidden" />
          @if (returnUserId.HasValue)
          {
            <input type="hidden" name="userId" value="@returnUserId.Value" />
          }

          <div class="mb-3">
            <label asp-for="DepartmentID" class="form-label fw-semibold">Department</label>
            <select asp-for="DepartmentID" asp-items="Model.DepartmentList" class="form-select">
              <option value="">-- Select Department --</option>
            </select>
            <span asp-validation-for="DepartmentID" class="text-danger small"></span>
          </div>
          <div class="mb-3">
            <label asp-for="StaffName" class="form-label fw-semibold">Staff Name</label>
            <input asp-for="StaffName" class="form-control" placeholder="Full name" />
            <span asp-validation-for="StaffName" class="text-danger small"></span>
          </div>
          <div class="row g-3 mb-3">
            <div class="col-md-6">
              <label asp-for="MobileNo" class="form-label fw-semibold">Mobile No</label>
              <input asp-for="MobileNo" class="form-control" placeholder="Mobile number" />
              <span asp-validation-for="MobileNo" class="text-danger small"></span>
            </div>
            <div class="col-md-6">
              <label asp-for="EmailAddress" class="form-label fw-semibold">Email</label>
              <input asp-for="EmailAddress" type="email" class="form-control" placeholder="Email address" />
              <span asp-validation-for="EmailAddress" class="text-danger small"></span>
            </div>
          </div>
          <div class="mb-4">
            <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="2" placeholder="Optional remarks…"></textarea>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn fw-bold px-4"
                    style="background:linear-gradient(135deg,var(--adm-primary),var(--adm-accent));color:#fff;border:none;border-radius:10px;box-shadow:0 4px 14px rgba(14,165,233,.25);font-family:'Inter',sans-serif;">
              <i class="bi bi-save me-1"></i>Update Staff
            </button>
            @if (returnUserId.HasValue)
            {
              <a asp-action="UserDetail" asp-route-id="@returnUserId.Value" asp-route-tab="staff" class="btn btn-outline-secondary" style="border-radius:8px;">
                <i class="bi bi-x me-1"></i>Cancel
              </a>
            }
            else
            {
              <a asp-action="AllStaff" class="btn btn-outline-secondary" style="border-radius:8px;">
                <i class="bi bi-x me-1"></i>Cancel
              </a>
            }
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
