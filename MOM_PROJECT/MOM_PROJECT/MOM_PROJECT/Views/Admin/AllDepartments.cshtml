@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var list = Model as List<Dictionary<string, object>> ?? new();
}
<div class="pagetitle mb-3">
  <h1 style="color:var(--adm-primary);"><i class="bi bi-building-fill me-2"></i>All Departments</h1>
  <nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li><li class="breadcrumb-item active">Departments</li></ol></nav>
</div>
<div class="card border-0 shadow-sm" style="border-radius:14px;">
  <div class="card-header border-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
       style="background:linear-gradient(135deg,#92400e,#d97706);border-radius:14px 14px 0 0;padding:.9rem 1.2rem;">
    <h6 class="mb-0 text-white fw-bold"><i class="bi bi-building me-2"></i>All Departments (@list.Count)</h6>
    <form method="get" class="d-flex">
      <input type="text" name="search" value="@ViewBag.SearchText" placeholder="Search…"
             class="form-control form-control-sm me-2" style="min-width:180px;border-radius:8px;">
      <button type="submit" class="btn btn-sm btn-light" style="border-radius:8px;"><i class="bi bi-search"></i></button>
    </form>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 admin-table">
        <thead>
          <tr><th class="ps-3">#</th><th>Department Name</th><th class="text-center">Staff</th><th>Created By</th><th class="text-center">Actions</th></tr>
        </thead>
        <tbody>
          @{ int i = 1; }
          @foreach (var d in list)
          {
            var staffCount = Convert.ToInt32(d["StaffCount"]);
            <tr>
              <td class="ps-3 text-muted" style="font-size:.82rem;">@(i++)</td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle d-flex align-items-center justify-content-center"
                       style="width:30px;height:30px;background:linear-gradient(135deg,#d97706,#fbbf24);color:#fff;font-size:.75rem;font-weight:700;flex-shrink:0;">
                    @(d["DepartmentName"].ToString()!.Substring(0,1))
                  </div>
                  <span class="fw-semibold" style="font-size:.87rem;">@d["DepartmentName"]</span>
                </div>
              </td>
              <td class="text-center">
                <span class="badge @(staffCount == 0 ? "bg-secondary" : "bg-warning text-dark")">@staffCount staff</span>
              </td>
              <td><span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size:.75rem;">@(d["CreatedBy"])</span></td>
              <td class="text-center" style="white-space:nowrap;">
                <a asp-action="AdminEditDept" asp-route-id="@d["DepartmentID"]" class="btn-admin-edit me-1">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <button onclick="confirmDelete('@Url.Action("AdminDeleteDept","Admin",new{id=d["DepartmentID"]})', '@d["DepartmentName"]')"
                        class="btn-admin-delete"><i class="bi bi-trash me-1"></i>Delete</button>
              </td>
            </tr>
          }
          @if (!list.Any()) { <tr><td colspan="5" class="text-center py-4 text-muted">No departments found.</td></tr> }
        </tbody>
      </table>
    </div>
  </div>
</div>
