@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    ViewBag.Title = "Manage Users";
    var list = Model as List<Dictionary<string, object>> ?? new();
}

<div class="pagetitle mb-3">
  <h1><i class="bi bi-people-fill me-2" style="color:var(--adm-primary);"></i>Manage Users</h1>
  <nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li><li class="breadcrumb-item active">Users</li></ol></nav>
</div>

<div class="card border-0">
  <div class="card-header border-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
       style="background:linear-gradient(135deg,#0f172a,#1e293b,#334155);border-radius:16px 16px 0 0;padding:.9rem 1.4rem;">
    <h6 class="mb-0 fw-bold" style="color:#e2e8f0;font-family:'Inter',sans-serif;">
      <i class="bi bi-people me-2" style="color:var(--adm-primary);"></i>All Users
      <span style="color:var(--adm-primary);">(@list.Count)</span>
    </h6>
    <div class="d-flex gap-2">
      <form method="get" class="d-flex">
        <input type="text" name="search" value="@ViewBag.SearchText" placeholder="Search username…"
               class="form-control form-control-sm me-2"
               style="min-width:180px;border-radius:10px;border:1px solid #e2e8f0;font-size:.82rem;font-family:'Inter',sans-serif;">
        <button type="submit" class="btn btn-sm"
                style="border-radius:10px;background:rgba(14,165,233,.15);color:var(--adm-primary);border:1px solid rgba(14,165,233,.2);font-weight:600;">
          <i class="bi bi-search"></i>
        </button>
      </form>
      <a asp-action="UserAddEdit" class="btn btn-sm fw-bold"
         style="border-radius:10px;background:linear-gradient(135deg,var(--adm-primary),var(--adm-accent));color:#fff;border:none;padding:5px 14px;font-size:.82rem;font-family:'Inter',sans-serif;box-shadow:0 2px 10px rgba(14,165,233,.25);">
        <i class="bi bi-plus-lg me-1"></i>Add User
      </a>
    </div>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 admin-table">
        <thead>
          <tr>
            <th class="ps-3">#</th>
            <th>Username</th>
            <th>Role</th>
            <th>Created</th>
            <th>Last Modified</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          @{ int i = 1; }
          @foreach (var u in list)
          {
            var role   = u["Role"].ToString() ?? "Member";
            <tr>
              <td class="ps-3" style="color:#94a3b8;font-size:.78rem;">@(i++)</td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle d-flex align-items-center justify-content-center"
                       style="width:32px;height:32px;background:linear-gradient(135deg,#0f172a,#1e293b);color:#0ea5e9;font-size:.72rem;font-weight:800;flex-shrink:0;font-family:'Inter',sans-serif;">
                    @(u["Username"].ToString()!.Substring(0,1).ToUpper())
                  </div>
                  <a asp-action="UserDetail" asp-route-id="@u["UserID"]" class="fw-bold text-decoration-none" style="font-size:.87rem;color:#0f172a;">
                    @u["Username"]
                  </a>
                </div>
              </td>
              <td>
                <span style="font-size:.65rem;background:linear-gradient(135deg,var(--adm-primary),var(--adm-accent));color:#fff;padding:2px 10px;border-radius:6px;font-weight:700;">@role</span>
              </td>
              <td style="font-size:.82rem;color:#64748b;">@Convert.ToDateTime(u["Created"]).ToString("dd MMM yyyy")</td>
              <td style="font-size:.82rem;color:#64748b;">@Convert.ToDateTime(u["Modified"]).ToString("dd MMM yyyy")</td>
              <td class="text-center" style="white-space:nowrap;">
                <a asp-action="UserDetail" asp-route-id="@u["UserID"]" class="btn-admin-view me-1">
                  <i class="bi bi-eye me-1"></i>View
                </a>
                <a asp-action="UserAddEdit" asp-route-id="@u["UserID"]" class="btn-admin-edit me-1">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <button onclick="confirmDelete('@Url.Action("DeleteUser","Admin",new{id=u["UserID"]})', '@u["Username"]')"
                        class="btn-admin-delete">
                  <i class="bi bi-trash3 me-1"></i>Delete
                </button>
              </td>
            </tr>
          }
          @if (!list.Any())
          {
            <tr><td colspan="6" class="text-center py-4" style="color:#94a3b8;">No users found.</td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
