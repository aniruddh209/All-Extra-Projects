@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var list = Model as List<Dictionary<string, object>> ?? new();
    int meetingId = ViewBag.MeetingID ?? 0;
    int? returnUserId = ViewBag.ReturnUserID as int?;
}

<div class="pagetitle mb-3">
  <h1><i class="bi bi-people-fill me-2" style="color:var(--adm-primary);"></i>Meeting Members</h1>
  <nav><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li>
    @if (returnUserId.HasValue)
    {
      <li class="breadcrumb-item"><a asp-action="UserDetail" asp-route-id="@returnUserId.Value">User</a></li>
    }
    <li class="breadcrumb-item"><a asp-action="AllMeetings">Meetings</a></li>
    <li class="breadcrumb-item active">Members</li>
  </ol></nav>
</div>

@if (ViewBag.MeetingDescription != null)
{
  <div class="alert border-0 mb-3" style="background:linear-gradient(135deg,rgba(14,165,233,.06),rgba(6,182,212,.06));border:1px solid rgba(14,165,233,.1);border-radius:12px;">
    <strong><i class="bi bi-info-circle me-2" style="color:var(--adm-primary);"></i>Meeting:</strong>
    @ViewBag.MeetingDescription
    <span class="ms-2 text-muted" style="font-size:.85rem;">(@Convert.ToDateTime(ViewBag.MeetingDate).ToString("dd MMM yyyy"))</span>
  </div>
}

<div class="card border-0 shadow-sm" style="border-radius:14px;">
  <div class="card-header border-0 d-flex justify-content-between align-items-center"
       style="background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px 16px 0 0;padding:.9rem 1.4rem;">
    <h6 class="mb-0 text-white fw-bold"><i class="bi bi-person-check me-2"></i>Members (@list.Count)</h6>
    <div class="d-flex gap-2">
      <a asp-action="AdminMemberAddEdit" asp-route-meetingId="@meetingId" asp-route-userId="@returnUserId" class="btn btn-sm btn-light fw-bold" style="border-radius:8px;">
        <i class="bi bi-plus-lg me-1"></i>Add Member
      </a>
      @if (returnUserId.HasValue)
      {
        <a asp-action="UserDetail" asp-route-id="@returnUserId.Value" asp-route-tab="meetings" class="btn btn-sm btn-outline-light" style="border-radius:8px;">
          <i class="bi bi-arrow-left me-1"></i>Back to User
        </a>
      }
      else
      {
        <a asp-action="AllMeetings" class="btn btn-sm btn-outline-light" style="border-radius:8px;">
          <i class="bi bi-arrow-left me-1"></i>Back
        </a>
      }
    </div>
  </div>

  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 admin-table">
        <thead>
          <tr>
            <th class="ps-3">#</th>
            <th>Staff Name</th>
            <th>Department</th>
            <th>Attendance</th>
            <th>Remarks</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          @{ int i = 1; }
          @foreach (var m in list)
          {
            var present = Convert.ToBoolean(m["IsPresent"]);
            <tr>
              <td class="ps-3 text-muted" style="font-size:.82rem;">@(i++)</td>
              <td>
                <div class="d-flex align-items-center gap-2">
                  <div class="rounded-circle d-flex align-items-center justify-content-center"
                       style="width:30px;height:30px;background:linear-gradient(135deg,#0f172a,#1e293b);color:#0ea5e9;font-size:.75rem;font-weight:700;flex-shrink:0;">
                    @(m["StaffName"].ToString()!.Substring(0,1))
                  </div>
                  <span class="fw-semibold" style="font-size:.87rem;">@m["StaffName"]</span>
                </div>
              </td>
              <td style="font-size:.82rem;">@m["DepartmentName"]</td>
              <td>
                @if (present)
                { <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Present</span> }
                else
                { <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i>Absent</span> }
              </td>
              <td style="font-size:.82rem;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">
                @(string.IsNullOrEmpty(m["Remarks"]?.ToString()) ? "—" : m["Remarks"])
              </td>
              <td class="text-center">
                <a asp-action="AdminMemberAddEdit" asp-route-meetingId="@meetingId" asp-route-id="@m["MeetingMemberID"]" asp-route-userId="@returnUserId"
                   class="btn-admin-edit me-1"><i class="bi bi-pencil me-1"></i>Edit</a>
                <button onclick="confirmDelete('@Url.Action("AdminDeleteMember","Admin",new{id=m["MeetingMemberID"],meetingId=meetingId,userId=returnUserId})', '@m["StaffName"]')"
                        class="btn-admin-delete"><i class="bi bi-trash me-1"></i>Remove</button>
              </td>
            </tr>
          }
          @if (!list.Any())
          {
            <tr><td colspan="6" class="text-center py-4 text-muted">No members added yet.</td></tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>
