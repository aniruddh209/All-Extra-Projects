@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var list = Model as List<Dictionary<string, object>> ?? new();
}
<div class="pagetitle mb-3">
  <h1 style="color:var(--adm-primary);"><i class="bi bi-geo-alt-fill me-2"></i>Meeting Venues</h1>
  <nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li><li class="breadcrumb-item active">Venues</li></ol></nav>
</div>
<div class="card border-0 shadow-sm" style="border-radius:14px;">
  <div class="card-header border-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
       style="background:linear-gradient(135deg,#134e4a,#0d9488);border-radius:14px 14px 0 0;padding:.9rem 1.2rem;">
    <h6 class="mb-0 text-white fw-bold"><i class="bi bi-geo-alt me-2"></i>All Meeting Venues (@list.Count)</h6>
    <form method="get" class="d-flex">
      <input type="text" name="search" value="@ViewBag.SearchText" placeholder="Search…"
             class="form-control form-control-sm me-2" style="min-width:180px;border-radius:8px;">
      <button type="submit" class="btn btn-sm btn-light" style="border-radius:8px;"><i class="bi bi-search"></i></button>
    </form>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 admin-table">
        <thead>
          <tr><th class="ps-3">#</th><th>Venue Name</th><th>Created On</th><th>Created By</th><th class="text-center">Actions</th></tr>
        </thead>
        <tbody>
          @{ int i = 1; }
          @foreach (var v in list)
          {
            <tr>
              <td class="ps-3 text-muted" style="font-size:.82rem;">@(i++)</td>
              <td class="fw-semibold" style="font-size:.87rem;"><i class="bi bi-geo-alt text-teal me-1" style="color:#0d9488;"></i>@v["MeetingVenueName"]</td>
              <td style="font-size:.82rem;">@Convert.ToDateTime(v["Created"]).ToString("dd MMM yyyy")</td>
              <td><span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size:.75rem;">@(v["CreatedBy"])</span></td>
              <td class="text-center" style="white-space:nowrap;">
                <a asp-action="AdminEditVenue" asp-route-id="@v["MeetingVenueID"]" class="btn-admin-edit me-1">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <button onclick="confirmDelete('@Url.Action("AdminDeleteVenue","Admin",new{id=v["MeetingVenueID"]})', '@v["MeetingVenueName"]')"
                        class="btn-admin-delete"><i class="bi bi-trash me-1"></i>Delete</button>
              </td>
            </tr>
          }
          @if (!list.Any()) { <tr><td colspan="5" class="text-center py-4 text-muted">No venues found.</td></tr> }
        </tbody>
      </table>
    </div>
  </div>
</div>
