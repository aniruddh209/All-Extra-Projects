@model MOM_PROJECT.Models.AdminMemberModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = Model.MeetingMemberID > 0;
    ViewBag.Title = isEdit ? "Edit Member" : "Add Member";
    int? returnUserId = ViewBag.ReturnUserID as int?;
}

<div class="pagetitle mb-3">
  <h1><i class="bi bi-person-@(isEdit ? "gear" : "plus-fill") me-2" style="color:var(--adm-primary);"></i>@(isEdit ? "Edit Member" : "Add Member")</h1>
  <nav><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li>
    @if (returnUserId.HasValue)
    {
      <li class="breadcrumb-item"><a asp-action="UserDetail" asp-route-id="@returnUserId.Value">User</a></li>
    }
    <li class="breadcrumb-item"><a asp-action="AllMeetingMembers" asp-route-meetingId="@Model.MeetingID" asp-route-userId="@returnUserId">Members</a></li>
    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Add")</li>
  </ol></nav>
</div>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm" style="border-radius:16px;">
      <div class="card-header border-0" style="background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px 16px 0 0;padding:1rem 1.4rem;">
        <h6 class="mb-0 text-white fw-bold"><i class="bi bi-person-check me-2"></i>Member Details</h6>
      </div>
      <div class="card-body p-4">
        <form asp-action="AdminMemberSave" method="post">
          @Html.AntiForgeryToken()
          @Html.HiddenFor(m => m.MeetingMemberID)
          @Html.HiddenFor(m => m.MeetingID)
          @if (returnUserId.HasValue)
          {
            <input type="hidden" name="userId" value="@returnUserId.Value" />
          }

          @if (!isEdit)
          {
            <div class="mb-3">
              <label asp-for="StaffID" class="form-label fw-semibold">Staff Member</label>
              <select asp-for="StaffID" asp-items="Model.StaffList" class="form-select">
                <option value="">-- Select Staff --</option>
              </select>
              <span asp-validation-for="StaffID" class="text-danger small"></span>
            </div>
          }

          <div class="mb-3">
            <label class="form-label fw-semibold">Attendance</label>
            <div class="d-flex gap-3">
              <div class="form-check">
                <input class="form-check-input" type="radio" name="IsPresent" id="isPresentYes" value="true"
                       @(Model.IsPresent ? "checked" : "") />
                <label class="form-check-label text-success fw-semibold" for="isPresentYes">
                  <i class="bi bi-check-circle me-1"></i>Present
                </label>
              </div>
              <div class="form-check">
                <input class="form-check-input" type="radio" name="IsPresent" id="isPresentNo" value="false"
                       @(!Model.IsPresent ? "checked" : "") />
                <label class="form-check-label text-danger fw-semibold" for="isPresentNo">
                  <i class="bi bi-x-circle me-1"></i>Absent
                </label>
              </div>
            </div>
          </div>

          <div class="mb-4">
            <label asp-for="Remarks" class="form-label fw-semibold">Remarks</label>
            <textarea asp-for="Remarks" class="form-control" rows="3" placeholder="Optional remarks…"></textarea>
            <span asp-validation-for="Remarks" class="text-danger small"></span>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn fw-bold px-4" style="background:linear-gradient(135deg,var(--adm-primary),var(--adm-accent));color:#fff;border:none;border-radius:10px;box-shadow:0 4px 14px rgba(14,165,233,.25);font-family:'Inter',sans-serif;">
              <i class="bi bi-save me-1"></i>@(isEdit ? "Update" : "Add Member")
            </button>
            <a asp-action="AllMeetingMembers" asp-route-meetingId="@Model.MeetingID" asp-route-userId="@returnUserId" class="btn btn-outline-secondary" style="border-radius:8px;">
              <i class="bi bi-x me-1"></i>Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
