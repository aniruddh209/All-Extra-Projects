@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    var list = Model as List<Dictionary<string, object>> ?? new();
}
<div class="pagetitle mb-3">
  <h1 style="color:var(--adm-primary);"><i class="bi bi-calendar-event-fill me-2"></i>All Meetings</h1>
  <nav><ol class="breadcrumb"><li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li><li class="breadcrumb-item active">All Meetings</li></ol></nav>
</div>
<div class="card border-0 shadow-sm" style="border-radius:14px;">
  <div class="card-header border-0 d-flex flex-wrap justify-content-between align-items-center gap-2"
       style="background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px 16px 0 0;padding:.9rem 1.4rem;">
    <h6 class="mb-0 text-white fw-bold"><i class="bi bi-calendar-event me-2"></i>All Meetings (@list.Count)</h6>
    <form method="get" class="d-flex">
      <input type="text" name="search" value="@ViewBag.SearchText" placeholder="Search…"
             class="form-control form-control-sm me-2" style="min-width:200px;border-radius:8px;">
      <button type="submit" class="btn btn-sm btn-light" style="border-radius:8px;"><i class="bi bi-search"></i></button>
    </form>
  </div>
  <div class="card-body p-0">
    <div class="table-responsive">
      <table class="table table-hover mb-0 admin-table">
        <thead>
          <tr>
            <th class="ps-3">#</th><th>Date</th><th>Description</th><th>Department</th>
            <th>Type</th><th>Created By</th><th>Status</th><th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          @{ int i = 1; }
          @foreach (var m in list)
          {
            var cancelled = Convert.ToBoolean(m["IsCancelled"]);
            <tr>
              <td class="ps-3 text-muted" style="font-size:.8rem;">@(i++)</td>
              <td style="font-size:.82rem;white-space:nowrap;">@Convert.ToDateTime(m["MeetingDate"]).ToString("dd MMM yy HH:mm")</td>
              <td style="font-size:.82rem;max-width:150px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;" title="@m["MeetingDescription"]">@m["MeetingDescription"]</td>
              <td style="font-size:.82rem;">@m["DepartmentName"]</td>
              <td><span class="badge bg-primary bg-opacity-10 text-primary" style="font-size:.75rem;">@m["MeetingTypeName"]</span></td>
              <td><span class="badge bg-secondary bg-opacity-10 text-secondary" style="font-size:.75rem;">@m["CreatedBy"]</span></td>
              <td>
                @if (cancelled) { <span class="badge bg-danger" title="@m["CancellationReason"]">Cancelled</span> }
                else            { <span class="badge bg-success">Active</span> }
              </td>
              <td class="text-center" style="white-space:nowrap;">
                <a asp-action="AllMeetingMembers" asp-route-meetingId="@m["MeetingID"]" class="btn-admin-view me-1">
                  <i class="bi bi-people me-1"></i>Members
                </a>
                <a asp-action="AdminEditMeeting" asp-route-id="@m["MeetingID"]" class="btn-admin-edit me-1">
                  <i class="bi bi-pencil me-1"></i>Edit
                </a>
                <button onclick="confirmDelete('@Url.Action("AdminDeleteMeeting","Admin",new{id=m["MeetingID"]})', 'this meeting')"
                        class="btn-admin-delete"><i class="bi bi-trash me-1"></i>Delete</button>
              </td>
            </tr>
          }
          @if (!list.Any()) { <tr><td colspan="8" class="text-center py-4 text-muted">No meetings found.</td></tr> }
        </tbody>
      </table>
    </div>
  </div>
</div>
