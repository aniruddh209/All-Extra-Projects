@model MOM_PROJECT.Models.AdminUserModel
@{
    Layout = "~/Views/Admin/_AdminLayout.cshtml";
    bool isEdit = Model.UserID > 0;
    ViewBag.Title = isEdit ? "Edit User" : "Add User";
}

<div class="pagetitle mb-3">
  <h1 style="color:var(--adm-primary);"><i class="bi bi-person-@(isEdit ? "gear" : "plus") me-2"></i>@(isEdit ? "Edit User" : "Add New User")</h1>
  <nav><ol class="breadcrumb">
    <li class="breadcrumb-item"><a asp-action="AdminDashboard">Dashboard</a></li>
    <li class="breadcrumb-item"><a asp-action="UserList">Users</a></li>
    <li class="breadcrumb-item active">@(isEdit ? "Edit" : "Add")</li>
  </ol></nav>
</div>

<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card border-0 shadow-sm" style="border-radius:16px;">
      <div class="card-header border-0" style="background:linear-gradient(135deg,#0f172a,#1e293b);border-radius:16px 16px 0 0;padding:1rem 1.4rem;">
        <h6 class="mb-0 text-white fw-bold">
          <i class="bi bi-person-fill me-2"></i>User Details
        </h6>
      </div>
      <div class="card-body p-4">
        <form asp-action="UserAddEdit" method="post">
          @Html.AntiForgeryToken()
          @Html.HiddenFor(m => m.UserID)

          <div class="mb-3">
            <label asp-for="Username" class="form-label fw-semibold">Username</label>
            <input asp-for="Username" class="form-control" placeholder="Enter username" />
            <span asp-validation-for="Username" class="text-danger small"></span>
          </div>

          <div class="mb-3">
            <label asp-for="Password" class="form-label fw-semibold">
              Password @(isEdit ? "(leave blank to keep current)" : "")
            </label>
            <div class="input-group">
              <input asp-for="Password" type="password" class="form-control" id="uPassword"
                     placeholder="@(isEdit ? "Leave blank to keep unchanged" : "Set a password")" />
              <button type="button" class="btn btn-outline-secondary" onclick="toggleUPwd()">
                <i class="bi bi-eye" id="uPwdEye"></i>
              </button>
            </div>
            <span asp-validation-for="Password" class="text-danger small"></span>
          </div>

          <div class="mb-4">
            <label asp-for="Role" class="form-label fw-semibold">Role</label>
            <select asp-for="Role" class="form-select">
              <option value="Member">Member</option>
              <option value="Admin">Admin</option>
            </select>
            <span asp-validation-for="Role" class="text-danger small"></span>
          </div>

          <div class="d-flex gap-2">
            <button type="submit" class="btn fw-bold px-4" style="background:linear-gradient(135deg,var(--adm-primary),var(--adm-accent));color:#fff;border:none;border-radius:8px;">
              <i class="bi bi-save me-1"></i>@(isEdit ? "Update User" : "Create User")
            </button>
            <a asp-action="UserList" class="btn btn-outline-secondary" style="border-radius:8px;">
              <i class="bi bi-x me-1"></i>Cancel
            </a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>

<script>
function toggleUPwd() {
  var inp = document.getElementById('uPassword');
  var eye = document.getElementById('uPwdEye');
  inp.type = inp.type === 'password' ? 'text' : 'password';
  eye.className = inp.type === 'text' ? 'bi bi-eye-slash' : 'bi bi-eye';
}
</script>
