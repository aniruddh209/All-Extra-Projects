@model List<MOM_PROJECT.Models.DepartmentModel>

@{
    ViewData["Title"] = "Department List";
    Layout = "_Layout";
}

<div class="container-fluid px-4 mt-4">

  <!-- Page Header -->
  <div class="d-flex justify-content-between align-items-center mb-4">
    <div>
      <div class="mom-page-title">🏢 Departments</div>
      <div class="mom-page-subtitle">Manage all company departments</div>
    </div>
  </div>

  <!-- Alerts -->
  @if (TempData["SuccessMessage"] != null)
  {
    <div class="mom-alert-success mb-3 d-flex justify-content-between align-items-center">
      <span>✅ @TempData["SuccessMessage"]</span>
    </div>
  }
  @if (TempData["ErrorMessage"] != null)
  {
    <div class="mom-alert-danger mb-3">
      ⚠️ @TempData["ErrorMessage"]
    </div>
  }

  <!-- Search Form -->
  <form method="post" asp-action="DepartmentList" asp-controller="Department" class="mb-3">
    <div class="mom-card" style="border-radius:14px;">
      <div class="mom-card-body" style="padding:16px 24px;">
        <div class="row g-2 align-items-end">
          <div class="col-md-5">
            <label class="mom-label" style="margin-bottom:6px;">🔍 Search by Department Name</label>
            <input type="text" name="SearchText" class="form-control mom-control"
                   placeholder="Enter department name..." value="@ViewBag.SearchText" />
          </div>
          <div class="col-md-4 d-flex gap-2">
            <button type="submit" class="mom-btn-save" style="padding:10px 24px;">
              🔍 Search
            </button>
            <a asp-action="DepartmentList" asp-controller="Department"
               class="btn btn-outline-secondary mom-btn-back" style="padding:10px 20px;">
              ↻ Reset
            </a>
          </div>
        </div>
      </div>
    </div>
  </form>

  <!-- Main Card -->
  <div class="mom-card">
    <div class="mom-card-header">
      <h5>🏢 All Departments</h5>
      <a asp-action="DepartmentAddEdit" asp-controller="Department" class="mom-btn-ghost">
        + Add Department
      </a>
    </div>

    <div class="mom-card-body">
      <table class="mom-table datatable">
        <thead>
          <tr>
            <th>Department</th>
            <th class="text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          @if (Model != null && Model.Count > 0)
          {
            foreach (var item in Model)
            {
              <tr>
                <td>
                  <div class="d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(item.DepartmentLogo))
                    {
                      <img src="@item.DepartmentLogo" alt="@item.DepartmentName"
                           style="width:40px; height:40px; border-radius:10px; object-fit:cover; box-shadow:0 2px 6px rgba(0,0,0,0.1);" />
                    }
                    else
                    {
                      <div class="mom-avatar">@item.DepartmentName.Substring(0,1).ToUpper()</div>
                    }
                    <span style="font-weight:600;color:#1e1b4b;">@item.DepartmentName</span>
                  </div>
                </td>
                <td class="text-center">
                  <div class="d-inline-flex gap-2">
                    <a asp-action="DepartmentView" asp-controller="Department"
                       asp-route-id="@item.DepartmentID" class="mom-btn-edit"
                       style="background:#e0f2fe; color:#0369a1;">👁 View</a>
                    <a asp-action="DepartmentAddEdit" asp-controller="Department"
                       asp-route-id="@item.DepartmentID" class="mom-btn-edit">✏ Edit</a>
                    <a asp-action="DeleteDepartment" asp-controller="Department"
                       asp-route-id="@item.DepartmentID" class="mom-btn-delete"
                       onclick="return confirm('Delete this department?');">🗑 Delete</a>
                  </div>
                </td>
              </tr>
            }
          }
          else
          {
            <tr>
              <td colspan="2" class="text-center text-muted py-5">
                <i class="bi bi-building fs-1 d-block mb-2 opacity-25"></i>
                No departments found
              </td>
            </tr>
          }
        </tbody>
      </table>
    </div>
  </div>
</div>

<link href="https://cdn.jsdelivr.net/npm/simple-datatables@latest/dist/style.css" rel="stylesheet">
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/simple-datatables@latest"></script>
<script>new simpleDatatables.DataTable(".datatable");</script>